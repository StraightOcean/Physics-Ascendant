{
  "name": "@physics-ascendant/client",
  "version": "0.1.0",
  "description": "Desktop UI for 物理法则之下：科技死斗",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx electron@28 .\"",
    "server": "npx tsx ../server/src/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "vite build && electron-builder",
    "build:electron:win": "vite build && electron-builder --win portable",
    "build:electron:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.physics-ascendant.desktop",
    "productName": "Physics Ascendant",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/mods",
        "to": "mods",
        "filter": ["*.json"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@physics-ascendant/engine": "file:../engine",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "28.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
